<div class="mb-6">
  <h1 class="text-2xl font-bold">Staff Dashboard – Pending Approvals</h1>
</div>

<% if @bookings.any? %>
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Resource</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Booked By</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Start Time</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">End Time</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Quantity</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @bookings.each do |booking| %>
          <tr>
            <td class="px-6 py-4"><%= booking.venue&.name || booking.equipment&.name %> (<%= booking.booking_type %>)</td>
            <td class="px-6 py-4"><%= booking.user&.email || 'Unknown' %></td>
            <td class="px-6 py-4"><%= booking.start_time.strftime("%Y-%m-%d %H:%M") %></td>
            <td class="px-6 py-4"><%= booking.end_time.strftime("%Y-%m-%d %H:%M") %></td>
            <td class="px-6 py-4">
              <% if booking.equipment.present? %>
                <%= booking.quantity || 1 %>
              <% else %>
                -
              <% end %>
            </td>
            <td class="px-6 py-4">
              <div class="flex gap-2">
                <%= button_to "Approve", approve_booking_path(booking), method: :patch,
                      class: "bg-green-600 hover:bg-green-700 text-white px-3 py-1 rounded text-sm" %>
                <%= button_to "Reject", reject_booking_path(booking), method: :patch,
                      class: "bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded text-sm" %>
                <%= button_to "Delete", booking_path(booking), method: :delete,
                      data: { 
                            confirm: "Permanently delete this booking?",
                            turbo_frame: "_top"
                            },
                      class: "bg-gray-600 hover:bg-gray-700 text-white px-3 py-1 rounded text-sm" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-gray-500">No pending bookings to approve.</p>
<% end %>