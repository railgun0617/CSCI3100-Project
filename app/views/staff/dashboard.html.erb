<div class="mb-6">
  <h1 class="text-2xl font-bold">Staff Dashboard – All Bookings</h1>
</div>

<% if @bookings.any? %>
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Resource</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Booked By</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Start Time</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">End Time</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @bookings.each do |booking| %>
          <tr>
            <td class="px-6 py-4"><%= booking.venue&.name || booking.equipment&.name %> (<%= booking.venue_id ? 'Venue' : 'Equipment' %>)</td>
            <td class="px-6 py-4"><%= booking.user&.email || 'Unknown' %></td>
            <td class="px-6 py-4"><%= booking.start_time.strftime("%Y-%m-%d %H:%M") %></td>
            <td class="px-6 py-4"><%= booking.end_time.strftime("%Y-%m-%d %H:%M") %></td>
            <td class="px-6 py-4">
              <span class="px-2 py-1 text-xs rounded-full
                <%= booking.status == 'approved' ? 'bg-green-100 text-green-800' :
                   booking.status == 'rejected' ? 'bg-red-100 text-red-800' :
                   'bg-yellow-100 text-yellow-800' %>">
                <%= booking.status.capitalize %>
              </span>
            </td>
            <td class="px-6 py-4 space-x-2">
              <%= button_to "Approve", approve_booking_path(booking), method: :patch, class: "bg-green-600 text-white px-3 py-1 rounded hover:bg-green-700" %>
              <%= button_to "Reject", reject_booking_path(booking), method: :patch, class: "bg-red-600 text-white px-3 py-1 rounded hover:bg-red-700" %>
              <%= button_to "Delete", booking_path(booking), method: :delete,
                    data: { confirm: "Permanently delete this booking?" },
                    class: "bg-gray-600 text-white px-3 py-1 rounded hover:bg-gray-700" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-gray-500">No bookings found.</p>
<% end %>