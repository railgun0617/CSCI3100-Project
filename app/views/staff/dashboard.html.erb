<div class="mb-6">
  <h1 class="text-2xl font-bold">Staff Dashboard – Pending Approvals</h1>
</div>

<div class="bg-white rounded-lg shadow overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
       <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Venue</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Booked By</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Start Time</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">End Time</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @pending_bookings.each do |booking| %>
        <tr>
          <td class="px-6 py-4"><%= booking.venue&.name || "N/A" %></td>
          <td class="px-6 py-4"><%= booking.user&.email || "unknown@example.com" %></td>
          <td class="px-6 py-4"><%= booking.start_time.strftime("%Y-%m-%d %H:%M") %></td>
          <td class="px-6 py-4"><%= booking.end_time.strftime("%Y-%m-%d %H:%M") %></td>
          <td class="px-6 py-4 space-x-2">
            <%= button_to "Approve", approve_booking_path(booking), method: :patch, class: "bg-green-600 text-white px-3 py-1 rounded hover:bg-green-700" %>
            <%= button_to "Reject", reject_booking_path(booking), method: :patch, class: "bg-red-600 text-white px-3 py-1 rounded hover:bg-red-700" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>