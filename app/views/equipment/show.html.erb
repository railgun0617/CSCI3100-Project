<div class="bg-white rounded-lg shadow p-6">
  <h1 class="text-2xl font-bold mb-2"><%= @equipment.name %></h1>
  <p class="text-gray-600 mb-4"><%= @equipment.description %></p>
  <div class="grid md:grid-cols-2 gap-6">
    <div>
      <h2 class="font-semibold text-lg">Details</h2>
      <ul class="mt-2 space-y-1">
        <li>Location: <%= @equipment.location %></li>
        <li>Available quantity: <%= @equipment.quantity %></li>
        <li>College/Dept: <%= @equipment.tenant&.name %></li>
      </ul>
      <%= link_to "Book This Equipment", new_booking_path(equipment_id: @equipment.id), class: "mt-4 inline-block bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700" %>
    </div>

    <div>
      <h2 class="font-semibold text-lg">Location Map</h2>

      <% if @equipment.latitude.present? && @equipment.longitude.present? %>
        <% zoom_level = 17   # 0 (world) to 21 (street level) %>
        <iframe
          width="100%"
          height="350"
          style="border: 1px solid black"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
          src="https://www.google.com/maps/embed/v1/search?key=AIzaSyB9rihEzb0gyIuURXCuzVk_kjc2RIHNnOg&q=<%= @equipment.latitude %>,<%= @equipment.longitude %>&center=<%= @equipment.latitude %>,<%= @equipment.longitude %>&zoom=<%= zoom_level %>">
        </iframe>
        <br/>
        <small>
          <a href="https://www.google.com/maps?q=<%= @equipment.latitude %>,<%= @equipment.longitude %>&z=<%= zoom_level %>" target="_blank">
            View larger map
          </a>
        </small>
      <% else %>
        <p class="text-gray-500">No location coordinates available.</p>
      <% end %>
    </div>
  </div>
</div>