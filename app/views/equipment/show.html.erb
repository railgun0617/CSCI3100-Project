<div class="bg-white rounded-lg shadow p-6">
  <h1 class="text-2xl font-bold mb-2"><%= @equipment.name %></h1>
  <p class="text-gray-600 mb-4"><%= @equipment.description %></p>

  <div class="grid md:grid-cols-2 gap-6">
    <div>
      <h2 class="font-semibold text-lg">Details</h2>
      <ul class="mt-2 space-y-1">
        <li>Location: <%= @equipment.location %></li>
        <li>Available quantity: <%= @equipment.quantity %></li>
        <li>Department: <%= @equipment.tenant&.name || 'N/A' %></li>   <!-- added (already had but kept consistent) -->
      </ul>
      <%= link_to "Book This Equipment", new_booking_path(resource_type: "equipment", resource_id: @equipment.id), 
                  class: "mt-4 inline-block bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700" %>
    </div>

    <div> 
      <% if @equipment.latitude.present? && @equipment.longitude.present? %>
        <div id="equipment-map" style="height: 400px; width: 100%; border-radius: 8px; border: 1px solid #ddd;"></div>
        <div class="mt-2 text-sm text-gray-600">
          <%= @equipment.latitude.to_f.round(6) %>, <%= @equipment.longitude.to_f.round(6) %>
        </div>
      <% else %>
        <p class="text-gray-500">No location coordinates available.</p>
      <% end %>
    </div>
  </div>
</div>

<% if @equipment.latitude.present? && @equipment.longitude.present? %>
<script>
  function initEquipmentMap() {
    const lat = <%= @equipment.latitude.to_f %>;
    const lng = <%= @equipment.longitude.to_f %>;
    const position = { lat: lat, lng: lng };

    const map = new google.maps.Map(document.getElementById("equipment-map"), {
      zoom: 16,
      center: position,
      mapTypeId: "roadmap"
    });

    new google.maps.Marker({
      position: position,
      map: map,
      title: "<%= @equipment.name %>",
      animation: google.maps.Animation.DROP
    });
  }

  if (typeof google === "undefined" || typeof google.maps === "undefined") {
    const script = document.createElement("script");
    script.src = "https://maps.googleapis.com/maps/api/js?key=AIzaSyAxUbNGOYu1pwytIqfaqnMI3JzahICa-Ls&callback=initEquipmentMap";
    script.async = true;
    script.defer = true;
    document.head.appendChild(script);
  } else {
    initEquipmentMap();
  }
</script>
<% end %>