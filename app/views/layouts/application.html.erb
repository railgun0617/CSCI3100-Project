<!DOCTYPE html>
<html>
  <head>
    <title>CUHK Booking SaaS</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-100">
    <nav class="bg-white shadow">
      <div class="container mx-auto px-4 py-3 flex justify-between items-center">
        <%= link_to "CUHK Booking", root_path, class: "text-xl font-bold text-blue-600" %>

        <div class="space-x-4">
          <!-- Always visible -->
          <%= link_to "Venues & Equipment", resources_path, class: "text-gray-700 hover:text-blue-600" %>

          <% if user_signed_in? %>
            <!-- Visible to signed-in users -->
            <%= link_to "My Bookings", bookings_path, class: "text-gray-700 hover:text-blue-600" %>

            <% if current_user.staff? %>
              <!-- Visible only to staff -->
              <%= link_to "Staff Dashboard", staff_dashboard_path, class: "text-gray-700 hover:text-blue-600" %>
              <%= link_to "Manage Resources", manage_resources_path, class: "text-gray-700 hover:text-blue-600" %>
              <%= link_to "Create Staff", new_admin_user_path, class: "text-gray-700 hover:text-blue-600" %>
            <% end %>

            <!-- Edit Account and Sign Out together -->
            <%= link_to "Edit Account", edit_user_registration_path, class: "text-gray-700 hover:text-blue-600" %>
            <%= button_to "Sign Out", destroy_user_session_path, method: :delete,
                          class: "text-gray-700 hover:text-blue-600 bg-transparent border-0",
                          form_class: "inline-block" %>
          <% else %>
            <!-- Visible only to guests -->
            <%= link_to "Sign Up", new_user_registration_path, class: "text-gray-700 hover:text-blue-600" %>
            <%= link_to "Sign In", new_user_session_path, class: "text-gray-700 hover:text-blue-600" %>
          <% end %>
        </div>
      </div>
    </nav>

    <main class="container mx-auto px-4 py-8 pb-24">
      <%= render 'layouts/alerts' %>
      <%= yield %>
    </main>

    <footer class="bg-white border-t fixed bottom-0 w-full">
      <div class="container mx-auto px-4 py-4 text-center text-gray-500 text-sm">
        CUHK Booking SaaS &copy; 2026
      </div>
    </footer>
  </body>
</html>