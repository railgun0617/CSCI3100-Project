<div class="mb-6">
  <h1 class="text-2xl font-bold">Login</h1>
</div>

<%= form_with url: login_path, local: true do |f| %>
  <div class="mb-4">
    <%= f.label :email, "Login ID", class: "block text-gray-700 font-bold mb-1" %>
    <%= f.email_field :email, class: "w-full p-2 border rounded-lg" %>
  </div>
 
  <div class="mb-4">
    <%= f.label :password, class: "block text-gray-700 font-bold mb-1" %>
    <%= f.password_field :password, class: "w-full p-2 border rounded-lg" %>
  </div>
 
  <div>
    <%= f.submit 'Login', class: "bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700"%>
  </div>
<% end %>