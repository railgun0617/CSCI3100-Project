<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">Departments</h1>
    <%= link_to new_admin_tenant_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg inline-flex items-center gap-2" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Add Department
    <% end %>
  </div>

  <!-- Search -->
  <div class="mb-6">
    <%= search_form_for @q, url: admin_tenants_path, method: :get, class: "flex gap-3 items-center" do |f| %>
      <div class="flex-1 relative">
        <%= f.text_field :name_cont,
                         value: params.dig(:q, :name_cont),
                         placeholder: "Search departments by name...",
                         class: "w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg" %>
        <div class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </div>
      </div>
      <%= f.submit "Search", class: "px-4 py-2 bg-blue-600 text-white rounded-lg" %>
      <% if params[:q].present? && params[:q][:name_cont].present? %>
        <%= link_to "Clear", admin_tenants_path, class: "px-4 py-2 text-gray-600" %>
      <% end %>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Slug</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @tenants.each do |tenant| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4"><%= tenant.name %></td>
            <td class="px-6 py-4"><%= tenant.slug || '-' %></td>
            <td class="px-6 py-4 text-right">
              <div class="flex justify-end gap-2">
                <%= link_to edit_admin_tenant_path(tenant), class: "bg-blue-500 text-white py-1 px-3 rounded text-sm" do %>Edit<% end %>
                <%= button_to admin_tenant_path(tenant), method: :delete, data: { confirm: "Are you sure?" }, class: "bg-red-500 text-white py-1 px-3 rounded text-sm" do %>Delete<% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>