<!-- This page lists all venues with a search bar (fuzzy search UI will be added later). -->

<div class="mb-6">
  <h1 class="text-2xl font-bold">Available Venues</h1>
</div>

<div class="mb-6" data-controller="search">
  <input type="text"
         data-search-target="input"
         data-action="input->search#search"
         placeholder="Search venues..."
         class="w-full p-2 border rounded-lg">
  <div data-search-target="results" class="absolute bg-white border rounded-lg shadow mt-1 w-full z-10"></div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  <% @venues.each do |venue| %>
    <div class="bg-white rounded-lg shadow p-4">
      <h2 class="text-xl font-semibold"><%= link_to venue.name, venue, class: "text-blue-600 hover:underline" %></h2>
      <p class="text-gray-600"><%= venue.description %></p>
      <p class="text-sm text-gray-500 mt-2">Capacity: <%= venue.capacity %></p>
      <%= link_to "Book", new_booking_path(venue_id: venue.id), class: "mt-3 inline-block bg-green-600 text-white px-3 py-1 rounded hover:bg-green-700" %>
    </div>
  <% end %>
</div>