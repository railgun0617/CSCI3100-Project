<div class="bg-white rounded-lg shadow p-6 max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold mb-4">Edit Venue</h1>

  <%= form_with model: @venue, local: true do |f| %>
    <div class="mb-4">
      <%= f.label :name, class: "block text-gray-700 font-medium mb-1" %>
      <%= f.text_field :name, class: "w-full p-2 border rounded-lg" %>
    </div>

    <div class="mb-4">
      <%= f.label :description, class: "block text-gray-700 font-medium mb-1" %>
      <%= f.text_area :description, rows: 3, class: "w-full p-2 border rounded-lg" %>
    </div>

    <div class="mb-4">
      <%= f.label :capacity, class: "block text-gray-700 font-medium mb-1" %>
      <%= f.number_field :capacity, class: "w-full p-2 border rounded-lg" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
      <div>
        <%= f.label :open_time, "Opening Time", class: "block text-gray-700 font-medium mb-1" %>
          <%= f.select :open_time, 
            (9..17).map { |h| ["#{h.to_s.rjust(2, '0')}:00", "#{h.to_s.rjust(2, '0')}:00"] },
            { selected: @venue.open_time&.strftime("%H:%M") || "09:00", include_blank: 'Select opening time' },
            { class: "w-full p-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" } %>
      </div>
      <div>
        <%= f.label :close_time, "Closing Time", class: "block text-gray-700 font-medium mb-1" %>
          <%= f.select :close_time,
          (9..17).map { |h| ["#{h.to_s.rjust(2, '0')}:00", "#{h.to_s.rjust(2, '0')}:00"] },
          { selected: @venue.close_time&.strftime("%H:%M") || "17:00", include_blank: 'Select closing time' },
          { class: "w-full p-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" } %>
      </div>
    </div>

    <!-- Map Picker -->
    <div class="mb-6">
      <label class="block text-gray-700 font-medium mb-1">Select Location on Map</label>
      <div id="map-picker" style="height: 400px; width: 100%; border-radius: 8px; border: 1px solid #ddd;"></div>
      
      <div id="map-info" class="mt-2 text-sm text-gray-600">
        Click on the map to select a location, then click "Confirm Location".
      </div>

      <button type="button" id="confirm-location" 
              class="mt-2 px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 hidden">
        Confirm Location
      </button>
    </div>

    <!-- Hidden fields for latitude and longitude -->
    <%= f.hidden_field :latitude, id: "venue_latitude" %>
    <%= f.hidden_field :longitude, id: "venue_longitude" %>

    <div class="flex justify-end space-x-2">
      <%= link_to "Cancel", venues_path, class: "px-4 py-2 border rounded-lg hover:bg-gray-100" %>
      <%= f.submit "Update Venue", class: "bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700" %>
    </div>
  <% end %>
</div>

<script>
  let map, marker, currentLocation;

  function initMapPicker() {
    // Default location (Hong Kong area)
    const defaultLat = <%= @venue.latitude.present? ? @venue.latitude.to_f : 22.419513 %>;
    const defaultLng = <%= @venue.longitude.present? ? @venue.longitude.to_f : 114.205158 %>;

    const defaultLocation = { lat: defaultLat, lng: defaultLng };

    map = new google.maps.Map(document.getElementById("map-picker"), {
      zoom: 17,
      center: defaultLocation,
    });

    // If editing and has existing coordinates, show the marker
    const latField = document.getElementById("venue_latitude");
    const lngField = document.getElementById("venue_longitude");

    if (latField.value && lngField.value) {
      const pos = { 
        lat: parseFloat(latField.value), 
        lng: parseFloat(lngField.value) 
      };
      placeMarker(pos);
      showCoordinates(pos);
      currentLocation = pos;
      document.getElementById("confirm-location").classList.remove("hidden");
    }

    // Click on map to change location
    map.addListener("click", (event) => {
      const location = event.latLng;
      placeMarker(location);
      showCoordinates(location);
      currentLocation = location;
      document.getElementById("confirm-location").classList.remove("hidden");
    });
  }

  function placeMarker(location) {
    if (marker) {
      marker.setPosition(location);
    } else {
      marker = new google.maps.Marker({ 
        position: location, 
        map: map, 
        title: "Selected location",
        draggable: true
      });
    }
  }

  function showCoordinates(location) {
    const lat = typeof location.lat === 'function' ? location.lat() : location.lat;
    const lng = typeof location.lng === 'function' ? location.lng() : location.lng;
    
    document.getElementById("map-info").innerHTML = 
      `Selected: Latitude ${parseFloat(lat).toFixed(6)}, Longitude ${parseFloat(lng).toFixed(6)}`;
  }

  // Confirm button
  document.getElementById("confirm-location").addEventListener("click", () => {
    if (currentLocation) {
      const lat = typeof currentLocation.lat === 'function' ? currentLocation.lat() : currentLocation.lat;
      const lng = typeof currentLocation.lng === 'function' ? currentLocation.lng() : currentLocation.lng;

      document.getElementById("venue_latitude").value = lat;
      document.getElementById("venue_longitude").value = lng;

      document.getElementById("map-info").innerHTML = 
        `Confirmed: Latitude ${parseFloat(lat).toFixed(6)}, Longitude ${parseFloat(lng).toFixed(6)} (ready to submit)`;
      
      document.getElementById("confirm-location").classList.add("hidden");
    } else {
      alert("No location selected. Click on the map first.");
    }
  });

  // Load Google Maps API
  if (typeof google === "undefined" || typeof google.maps === "undefined") {
    const script = document.createElement("script");
    script.src = "https://maps.googleapis.com/maps/api/js?key=AIzaSyB9rihEzb0gyIuURXCuzVk_kjc2RIHNnOg&callback=initMapPicker";
    script.async = true;
    script.defer = true;
    document.head.appendChild(script);
  } else {
    initMapPicker();
  }
</script>