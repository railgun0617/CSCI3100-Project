<div class="max-w-2xl mx-auto bg-white p-8 rounded-lg shadow-md mt-8 mb-12">
  <h1 class="text-2xl font-bold text-gray-800 mb-2">Add New Venue</h1>
  <p class="text-gray-500 mb-6">Fill in the details to create a new bookable space.</p>

  <%= form_with model: @venue, local: true, class: "space-y-6" do |f| %>
    <%= render "devise/shared/error_messages", resource: @venue %>

    <div>
      <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, autofocus: true, placeholder: "e.g., Lecture Theatre A, Seminar Room 202", class: "w-full px-4 py-3 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div>
      <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :description, rows: 4, placeholder: "Describe the venue, its facilities, and any special notes...", class: "w-full px-4 py-3 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div>
      <%= f.label :capacity, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :capacity, placeholder: "Number of people", class: "w-full px-4 py-3 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" %>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
      <div>
        <%= f.label :open_time, "Opening Time", class: "block text-gray-700 font-medium mb-1" %>
        <%= f.select :open_time, 
          (9..17).map { |h| ["#{h.to_s.rjust(2, '0')}:00", "#{h.to_s.rjust(2, '0')}:00"] },
          { selected: @venue.open_time&.strftime("%H:%M") || "09:00", include_blank: 'Select opening time' },
          { class: "w-full p-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" } %>
      </div>
      <div>
        <%= f.label :close_time, "Closing Time", class: "block text-gray-700 font-medium mb-1" %>
        <%= f.select :close_time,
          (9..17).map { |h| ["#{h.to_s.rjust(2, '0')}:00", "#{h.to_s.rjust(2, '0')}:00"] },
          { selected: @venue.close_time&.strftime("%H:%M") || "17:00", include_blank: 'Select closing time' },
          { class: "w-full p-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" } %>
      </div>
    </div>

    <%= render "shared/map_picker", f: f, latitude: @venue.latitude, longitude: @venue.longitude %>

    <!-- Tenant (department) handling -->
    <% if current_user&.staff? %>
      <%= f.hidden_field :tenant_id, value: current_user.tenant_id %>
      <div class="text-sm text-gray-600">Department: <%= current_user.tenant&.name || 'N/A' %></div>
    <% end %>

    <div class="flex justify-end space-x-3 pt-4">
      <%= link_to "Cancel", venues_path, class: "px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition" %>
      <%= f.submit "Create Venue", class: "bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-md transition cursor-pointer" %>
    </div>
  <% end %>
</div>