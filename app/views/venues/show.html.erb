<div class="bg-white rounded-lg shadow p-6">
  <h1 class="text-2xl font-bold mb-2"><%= @venue.name %></h1>
  <p class="text-gray-600 mb-4"><%= @venue.description %></p>
  <div class="grid md:grid-cols-2 gap-6">
    <div>
      <h2 class="font-semibold text-lg">Details</h2>
      <ul class="mt-2 space-y-1">
        <li>Capacity: <%= @venue.capacity %></li>
        <%# <li>College/Dept: <%= @venue.tenant&.name || 'N/A' %></li> 
      </ul>
      <%= link_to "Book This Venue", new_booking_path(venue_id: @venue.id), class: "mt-4 inline-block bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700" %>
    </div>

    <div>
      <h2 class="font-semibold text-lg">Location</h2>

      <% if @venue.latitude.present? && @venue.longitude.present? %>
        <% zoom_level = 17   # 0 (world) to 21 (street level) %>
        <iframe
          width="100%"
          height="350"
          style="border: 1px solid black"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
          src="https://www.google.com/maps/embed/v1/search?key=AIzaSyB9rihEzb0gyIuURXCuzVk_kjc2RIHNnOg&q=<%= @venue.latitude %>,<%= @venue.longitude %>&center=<%= @venue.latitude %>,<%= @venue.longitude %>&zoom=<%= zoom_level %>">
        </iframe>
        <br/>
        <small>
          <a href="https://www.google.com/maps?q=<%= @venue.latitude %>,<%= @venue.longitude %>&z=<%= zoom_level %>" target="_blank">
            View larger map
          </a>
        </small>
      <% else %>
        <p class="text-gray-500">No location coordinates available.</p>
      <% end %>
    </div>
  </div>
</div>