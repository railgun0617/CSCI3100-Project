<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-gray-800 mb-8">Manage Resources</h1>

  <!-- Unified Search Bar -->
  <div class="mb-8">
    <%= form_tag manage_resources_path, method: :get, class: "flex gap-3 items-center" do %>
      <div class="flex-1 relative">
        <%= text_field_tag :search, params[:search], placeholder: "Search venues or equipment by name, description, or location...", class: "w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" %>
        <div class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </div>
      </div>
      <%= submit_tag "Search", class: "px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg" %>
      <% if params[:search].present? %>
        <%= link_to "Clear", manage_resources_path, class: "px-6 py-3 text-gray-600 hover:text-gray-800" %>
      <% end %>
    <% end %>
  </div>

  <!-- Venues Section (unchanged table) -->
  <div class="mb-12">
    <div class="flex flex-wrap justify-between items-center mb-4 gap-3">
      <h2 class="text-2xl font-semibold text-gray-700">Venues</h2>
      <%= link_to new_venue_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg inline-flex items-center gap-2" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Add Venue
      <% end %>
    </div>
    <div class="overflow-x-auto bg-white rounded-xl shadow">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Capacity</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Department</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @venues.each do |venue| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4"><%= venue.name %></td>
              <td class="px-6 py-4"><%= venue.capacity %></td>
              <td class="px-6 py-4"><%= venue.tenant&.name || 'N/A' %></td>
              <td class="px-6 py-4 text-right">
                <div class="flex justify-end gap-2">
                  <%= link_to edit_venue_path(venue), class: "bg-blue-500 text-white py-1 px-3 rounded text-sm" do %>Edit<% end %>
                  <%= button_to venue_path(venue), method: :delete, data: { confirm: "Are you sure?" }, class: "bg-red-500 text-white py-1 px-3 rounded text-sm" do %>Delete<% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Equipment Section (unchanged table) -->
  <div>
    <div class="flex flex-wrap justify-between items-center mb-4 gap-3">
      <h2 class="text-2xl font-semibold text-gray-700">Equipment</h2>
      <%= link_to new_equipment_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg inline-flex items-center gap-2" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Add Equipment
      <% end %>
    </div>
    <div class="overflow-x-auto bg-white rounded-xl shadow">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Location</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Quantity</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Department</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @equipment.each do |item| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4"><%= item.name %></td>
              <td class="px-6 py-4"><%= item.location %></td>
              <td class="px-6 py-4"><%= item.quantity %></td>
              <td class="px-6 py-4"><%= item.tenant&.name || 'N/A' %></td>
              <td class="px-6 py-4 text-right">
                <div class="flex justify-end gap-2">
                  <%= link_to edit_equipment_path(item), class: "bg-blue-500 text-white py-1 px-3 rounded text-sm" do %>Edit<% end %>
                  <%= button_to equipment_path(item), method: :delete, data: { confirm: "Are you sure?" }, class: "bg-red-500 text-white py-1 px-3 rounded text-sm" do %>Delete<% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>