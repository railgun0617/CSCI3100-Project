<h1 class="text-2xl font-bold mb-6">All Venues & Equipment</h1>

<!-- Ransack Fuzzy Search Bar -->
<div class="mb-8">
  <%= search_form_for @q || Ransack::Search.new(Venue.none), 
                      url: resources_path, 
                      method: :get, 
                      class: "flex gap-3 items-center" do |f| %>
    
    <div class="flex-1 relative">
      <%= f.text_field :name_or_description_or_location_cont,
                       value: params.dig(:q, :name_or_description_or_location_cont),
                       placeholder: "Search venues or equipment by name, description or location...",
                       class: "w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-lg" %>
      <!-- Magnifying glass icon (left side) -->
      <div class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 01-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
    </div>

    <%= f.submit "Search", class: "px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors" %>

    <% if params[:q].present? && params[:q][:name_or_description_or_location_cont].present? %>
      <%= link_to "Clear", resources_path, 
                  class: "px-6 py-3 text-gray-600 hover:text-gray-800 font-medium transition-colors" %>
    <% end %>
  <% end %>
</div>

<!-- Results Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  <% if @resources.empty? %>
    <div class="col-span-full text-center py-16">
      <p class="text-gray-500 text-lg">
        No venues or equipment found matching 
        "<strong><%= params.dig(:q, :name_or_description_or_location_cont) %></strong>".
      </p>
      <%= link_to "Show all venues & equipment", resources_path, 
                  class: "mt-6 inline-block text-blue-600 hover:text-blue-800 font-medium" %>
    </div>
  <% else %>
    <% @resources.each do |resource| %>
      <div id="<%= resource.class.name.downcase %>_<%= resource.id %>" 
           class="bg-white rounded-lg shadow p-4 hover:shadow-lg transition flex flex-col h-full">

        <!-- Header with name and type badge -->
        <div class="flex justify-between items-start">
          <h2 class="text-xl font-semibold text-blue-600">
            <%= link_to resource.name, polymorphic_path(resource), class: "hover:underline" %>
          </h2>
          <span class="px-2 py-1 text-xs rounded-full 
            <%= resource.class.name == 'Venue' ? 'bg-blue-100 text-blue-800' : 'bg-green-100 text-green-800' %>">
            <%= resource.class.name %>
          </span>
        </div>

        <!-- Description -->
        <p class="text-gray-600 mt-2 text-sm line-clamp-3">
          <%= truncate(resource.description, length: 120) %>
        </p>

        <!-- Resource-specific details -->
        <div class="mt-3 space-y-1 text-sm text-gray-700">
          <% if resource.is_a?(Venue) %>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span class="break-words">
                Open: <strong><%= resource.open_time&.strftime("%H:%M") %> - <%= resource.close_time&.strftime("%H:%M") %></strong>
              </span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
              <span>Capacity: <strong><%= resource.capacity %></strong> people</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l2-2m-2 2l2 2m0 0l-2 2M7 12l2-2m0 0l2-2m-2 2l2 2m0 0l-2 2m2-8h6m2 0h2a2 2 0 012 2v8a2 2 0 01-2 2h-2m-6 0H5a2 2 0 01-2-2v-4m2 0h4"/>
              </svg>
              <span>Department: <strong><%= resource.tenant&.name || 'N/A' %></strong></span>   <!-- added -->
            </div>
          <% elsif resource.is_a?(Equipment) %>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span>Location: <strong><%= resource.location %></strong></span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
              </svg>
              <span>Quantity: <strong><%= resource.quantity %></strong> available</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l2-2m-2 2l2 2m0 0l-2 2M7 12l2-2m0 0l2-2m-2 2l2 2m0 0l-2 2m2-8h6m2 0h2a2 2 0 012 2v8a2 2 0 01-2 2h-2m-6 0H5a2 2 0 01-2-2v-4m2 0h4"/>
              </svg>
              <span>Department: <strong><%= resource.tenant&.name || 'N/A' %></strong></span>   <!-- added -->
            </div>
          <% end %>
        </div>

        <!-- Action buttons – pushed to bottom -->
        <div class="mt-auto pt-4 flex justify-between items-center">
          <%= link_to "View Details", polymorphic_path(resource), 
                      class: "text-blue-600 hover:text-blue-800 text-sm font-medium" %>
          
          <%= link_to "Book", new_booking_path(resource_type: resource.class.name.underscore, resource_id: resource.id), 
                      class: "bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded text-sm font-medium transition-colors" %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>