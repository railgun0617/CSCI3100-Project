<h1 class="text-2xl font-bold mb-6">All Venues & Equipment</h1>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  <% @resources.each do |resource| %>
    <div class="bg-white rounded-lg shadow p-4">
      <div class="flex justify-between items-start">
        <h2 class="text-xl font-semibold">
          <%= link_to resource.name, polymorphic_path(resource), class: "text-blue-600 hover:underline" %>
        </h2>
        <span class="px-2 py-1 text-xs rounded-full <%= resource.class.name == 'Venue' ? 'bg-blue-100 text-blue-800' : 'bg-green-100 text-green-800' %>">
          <%= resource.class.name %>
        </span>
      </div>
      <p class="text-gray-600 mt-2"><%= truncate(resource.description, length: 100) %></p>
      
      <%# Temporarily disabled until tenant association is added %>
      <%# <p class="text-sm text-gray-500 mt-2">Department: <%= resource.tenant&.name || 'N/A' </p> %>
      
      <div class="mt-3 flex justify-end">
        <%= link_to "Book", new_booking_path(resource_type: resource.class.name.underscore, resource_id: resource.id), class: "bg-green-600 text-white px-3 py-1 rounded hover:bg-green-700" %>
      </div>
    </div>
  <% end %>
</div>