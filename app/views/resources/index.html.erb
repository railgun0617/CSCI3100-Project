<h1 class="text-2xl font-bold mb-6">All Venues & Equipment</h1>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  <% @resources.each do |resource| %>
    <div class="bg-white rounded-lg shadow p-4 hover:shadow-lg transition flex flex-col h-full">
      <!-- Header with name and type badge -->
      <div class="flex justify-between items-start">
        <h2 class="text-xl font-semibold text-blue-600">
          <%= link_to resource.name, polymorphic_path(resource), class: "hover:underline" %>
        </h2>
        <span class="px-2 py-1 text-xs rounded-full 
          <%= resource.class.name == 'Venue' ? 'bg-blue-100 text-blue-800' : 'bg-green-100 text-green-800' %>">
          <%= resource.class.name %>
        </span>
      </div>

      <!-- Description -->
      <p class="text-gray-600 mt-2 text-sm"><%= truncate(resource.description, length: 120) %></p>

      <!-- Resource-specific details -->
      <div class="mt-3 space-y-1 text-sm text-gray-700">
        <% if resource.is_a?(Venue) %>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            <span>Capacity: <strong><%= resource.capacity %></strong> people</span>
          </div>
        <% elsif resource.is_a?(Equipment) %>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span>Location: <strong><%= resource.location %></strong></span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
            <span>Quantity: <strong><%= resource.quantity %></strong> available</span>
          </div>
        <% end %>
      </div>

      <!-- Action buttons – pushed to bottom with mt-auto -->
      <div class="mt-auto pt-4 flex justify-between items-center">
        <%= link_to "View Details", polymorphic_path(resource), class: "text-blue-600 hover:text-blue-800 text-sm font-medium" %>
        <%= link_to "Book", new_booking_path(resource_type: resource.class.name.underscore, resource_id: resource.id), class: "bg-green-600 hover:bg-green-700 text-white px-3 py-1 rounded text-sm" %>
      </div>
    </div>
  <% end %>
</div>