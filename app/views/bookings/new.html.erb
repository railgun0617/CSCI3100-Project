<div class="container mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-2">Book <%= @resource.name %></h1>
  <p class="text-gray-600 mb-6">Select an available time slot for the next 7 days.</p>

  <!-- Legend -->
  <div class="flex gap-4 mb-6 text-sm">
    <div class="flex items-center gap-1"><div class="w-4 h-4 bg-green-500 rounded"></div><span>Available</span></div>
    <div class="flex items-center gap-1"><div class="w-4 h-4 bg-red-500 rounded"></div><span>Booked</span></div>
    <div class="flex items-center gap-1"><div class="w-4 h-4 bg-gray-300 rounded"></div><span>Closed</span></div>
  </div>

  <!-- Timetable -->
  <div class="overflow-x-auto">
    <table class="min-w-full bg-white border border-gray-200 rounded-lg shadow">
      <thead>
        <tr class="bg-gray-100 border-b">
          <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">Date</th>
          <% if @resource.is_a?(Equipment) %>
            <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">Quantity</th>
          <% end %>
          <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">Time</th>
          <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">Status</th>
          <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">Action</th>
        </tr>
      </thead>
      <tbody>
        <% @time_slots.each do |slot| %>
          <tr class="border-b hover:bg-gray-50">
            <td class="px-4 py-2"><%= slot[:time].strftime("%A, %b %d") %></td>
            <% if @resource.is_a?(Equipment) && slot[:status] == 'available' %>
              <% max_qty = @max_quantities[slot[:time].to_i] || 0 %>
              <td class="px-4 py-2">
                <select class="quantity-select w-20 px-2 py-1 border border-gray-300 rounded text-sm" 
                  data-btn-id="btn_<%= slot[:time].to_i %>"
                  data-max="<%= max_qty %>">
                  <% (1..max_qty).each do |q| %>
                    <option value="<%= q %>" <%= q == 1 ? 'selected' : '' %>><%= q %></option>
                  <% end %>
                </select>
              </td>
            <% elsif @resource.is_a?(Equipment) %>
              <td class="px-4 py-2">-</td> <%# non-available can still maintain the td structure %>
            <% end %>
            <td class="px-4 py-2"><%= slot[:time].strftime("%I:%M %p") %></td>
            <td class="px-4 py-2">
              <span class="px-2 py-1 text-xs rounded-full
                <%= slot[:status] == 'available' ? 'bg-green-100 text-green-800' : 
                   slot[:status] == 'booked' ? 'bg-red-100 text-red-800' : 
                   'bg-gray-100 text-gray-600' %>">
                <%= slot[:status].capitalize %>
              </span>
            </td>
            <td class="px-4 py-2">
              <% if slot[:status] == 'available' %>
                <button type="button"
                  class="book-btn bg-blue-600 hover:bg-blue-700 text-white px-3 py-1 rounded text-sm"
                  data-start-time="<%= slot[:time].iso8601 %>"
                  data-end-time="<%= (slot[:time] + 1.hour).iso8601 %>">
                  Book
                </button>
              <% else %>
                <span class="text-gray-400 text-sm">Not available</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-6">
    <%= link_to "Back to Resources", resources_path, class: "text-blue-600 hover:underline" %>
  </div>
</div>

<% if @resource.is_a?(Equipment) %>
  <script>
    function updateQuantity(select) {
      const btnId = select.dataset.btnId;
      if (!btnId) return;
    
      const quantity = select.value;
      const form = document.getElementById(btnId)?.closest('form');
    
      if (!form) {
        console.error('Form not found for', btnId);
        return;
      }
    
      let qtyInput = form.querySelector('input[name="quantity"]');
    
      if (!qtyInput) {
        qtyInput = document.createElement('input');
        qtyInput.type = 'hidden';
        qtyInput.name = 'quantity';
        form.appendChild(qtyInput);
      }
    
      qtyInput.value = quantity;
    }
  
     // initalize all quantity select menu
    document.querySelectorAll('.quantity-select').forEach(select => {
      // set default value
      updateQuantity(select);
      // link to listener
      select.addEventListener('change', () => updateQuantity(select));
    });
  </script>
<% end %>

<%= action_cable_meta_tag %>
<script src="https://cdn.jsdelivr.net/npm/@rails/actioncable@7.0.0/app/assets/javascripts/actioncable.js"></script>
<script>
  (function() {
    const cable = ActionCable.createConsumer('/cable');
    const subscription = cable.subscriptions.create('BookingChannel', {
      connected() { console.log('WebSocket connected'); },
      disconnected() { console.log('WebSocket disconnected'); },
      received(data) {
        console.log('Received:', data); 
        if (data.type === 'book_success') {
          alert(data.message);
          location.reload();
        } else if (data.type === 'book_failed') {
          alert(data.message);
          location.reload();
        }
      },
      attempt_book(params) { this.perform('attempt_book', params); }
    });

    window.attemptBook = function(button) {
      const row = button.closest('tr');
      const resourceType = '<%= @resource.class.name.underscore %>';
      const resourceId = <%= @resource.id %>;
      const startTime = button.dataset.startTime;
      const endTime = button.dataset.endTime;
      let quantity = null;
      if (resourceType === 'equipment') {
        const select = row.querySelector('.quantity-select');
        if (select) quantity = select.value;
      }
      subscription.attempt_book({
        resource_type: resourceType,
        resource_id: resourceId,
        start_time: startTime,
        end_time: endTime,
        quantity: quantity,
        notes: ''
      });
    };

    function bindButtons() {
      document.querySelectorAll('.book-btn').forEach(btn => {
        if (btn.dataset.bound) return;
        btn.dataset.bound = 'true';
        btn.addEventListener('click', () => window.attemptBook(btn));
      });
    }
    bindButtons();
  })();
</script>