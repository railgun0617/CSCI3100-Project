<div class="bg-white rounded-lg shadow p-6 max-w-md mx-auto">
  <h1 class="text-2xl font-bold mb-4">Book <%= @venue.name %></h1>

  <%= form_with model: @booking, local: true do |f| %>
    <div class="mb-4">
      <%= f.label :start_time, "Start Time", class: "block text-gray-700 font-medium mb-1" %>
      <%= f.datetime_local_field :start_time, class: "w-full p-2 border rounded-lg" %>
    </div>

    <div class="mb-4">
      <%= f.label :end_time, "End Time", class: "block text-gray-700 font-medium mb-1" %>
      <%= f.datetime_local_field :end_time, class: "w-full p-2 border rounded-lg" %>
    </div>

    <div class="mb-4">
      <%= f.label :notes, "Notes (optional)", class: "block text-gray-700 font-medium mb-1" %>
      <%= f.text_area :notes, rows: 3, class: "w-full p-2 border rounded-lg" %>
    </div>

    <%= f.hidden_field :venue_id, value: @venue.id %>

    <div class="flex justify-end space-x-2">
      <%= link_to "Cancel", venues_path, class: "px-4 py-2 border rounded-lg hover:bg-gray-100" %>
      <%= f.submit "Submit Booking", class: "bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700" %>
    </div>
  <% end %>
</div>