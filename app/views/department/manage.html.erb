<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-6">Manage Your Department's Resources</h1>

  <div class="border-b border-gray-200 mb-6">
    <ul class="flex flex-wrap -mb-px text-sm font-medium text-center">
      <li class="mr-2">
        <a href="#venues" data-tab-target="venues" class="inline-block p-4 rounded-t-lg border-b-2 border-transparent hover:text-gray-600 hover:border-gray-300">Venues</a>
      </li>
      <li class="mr-2">
        <a href="#equipment" data-tab-target="equipment" class="inline-block p-4 rounded-t-lg border-b-2 border-transparent hover:text-gray-600 hover:border-gray-300">Equipment</a>
      </li>
    </ul>
  </div>

  <!-- Venues Tab -->
  <div id="venues-tab" class="tab-content">
    <div class="flex justify-end mb-4">
      <%= link_to "Add Venue", new_venue_path, class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
    </div>
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr><th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th><th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Capacity</th><th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th></tr>
        </thead>
        <tbody>
          <% @venues.each do |venue| %>
            <tr><td class="px-6 py-4"><%= venue.name %></td><td class="px-6 py-4"><%= venue.capacity %></td><td class="px-6 py-4 space-x-2"><%= link_to "Edit", edit_venue_path(venue), class: "text-blue-600 hover:underline" %><%= button_to "Delete", venue_path(venue), method: :delete, data: { confirm: "Are you sure?" }, class: "text-red-600 hover:underline" %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Equipment Tab -->
  <div id="equipment-tab" class="tab-content hidden">
    <div class="flex justify-end mb-4">
      <%= link_to "Add Equipment", new_equipment_path, class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
    </div>
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr><th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th><th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Location</th><th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Quantity</th><th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th></tr>
        </thead>
        <tbody>
          <% @equipment.each do |item| %>
            <tr><td class="px-6 py-4"><%= item.name %></td><td class="px-6 py-4"><%= item.location %></td><td class="px-6 py-4"><%= item.quantity %></td><td class="px-6 py-4 space-x-2"><%= link_to "Edit", edit_equipment_path(item), class: "text-blue-600 hover:underline" %><%= button_to "Delete", equipment_path(item), method: :delete, data: { confirm: "Are you sure?" }, class: "text-red-600 hover:underline" %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  // Simple tab switching
  document.querySelectorAll('[data-tab-target]').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = link.getAttribute('data-tab-target');
      document.querySelectorAll('.tab-content').forEach(tab => tab.classList.add('hidden'));
      document.getElementById(`${targetId}-tab`).classList.remove('hidden');
      document.querySelectorAll('[data-tab-target]').forEach(l => l.classList.remove('border-blue-600', 'text-blue-600'));
      link.classList.add('border-blue-600', 'text-blue-600');
    });
  });
  // Show first tab by default
  document.querySelector('[data-tab-target]').click();
</script>