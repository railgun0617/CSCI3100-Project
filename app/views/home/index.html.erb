<div class="text-center py-8">
  <h1 class="text-3xl font-bold">CUHK Venue & Equipment Booking</h1>
  <p class="text-gray-600 mt-2">Book rooms and equipment across colleges.</p>
</div>

<div class="grid md:grid-cols-2 gap-8 mt-8">
  <div class="bg-white rounded-lg shadow p-6 text-center">
    <h2 class="text-xl font-semibold">Find Venues</h2>
    <p class="text-gray-500 mt-2">Book lecture halls, meeting rooms, and more.</p>
    <%= link_to "Browse Venues", venues_path, class: "mt-4 inline-block bg-blue-600 text-white px-4 py-2 rounded" %>
  </div>

  <div class="bg-white rounded-lg shadow p-6 text-center">
    <h2 class="text-xl font-semibold">Browse Equipment</h2>
    <p class="text-gray-500 mt-2">Projectors, sound systems, cameras – available for your event.</p>
    <%= link_to "View Equipment", equipment_index_path, class: "mt-4 inline-block bg-green-600 text-white px-4 py-2 rounded" %>
  </div>
</div>